{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-podcast-studio/project.schema.json",
  "title": "AI Podcast Studio project",
  "type": "object",
  "required": ["project", "characters"],
  "allOf": [
    {
      "if": {"properties": {"models": {"properties": {"separation": {"const": "sepformer"}}}}, "required": ["models"]},
      "then": {"properties": {"models": {"properties": {"num_speakers": {"enum": [2, 3]}}}}}
    }
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "resolution", "fps"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "resolution": {"type": "string", "pattern": "^[1-9][0-9]{2,4}x[1-9][0-9]{2,4}$"},
        "fps": {"type": "integer", "minimum": 1, "maximum": 60}
      },
      "additionalProperties": true
    },
    "characters": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 3,
      "patternProperties": {
        "^char_[A-Za-z0-9_-]+$": {
          "type": "object",
          "properties": {
            "speaker_id": {"type": ["string", "null"]},
            "position": {"enum": ["left", "center", "right"]},
            "name": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
    "models": {
      "type": "object",
      "properties": {
        "vad": {"enum": ["energy", "silero", "auto"]},
        "diarization": {"enum": ["manual", "speechbrain_ecapa"]},
        "separation": {"enum": ["none", "sepformer"]},
        "num_speakers": {"type": "integer", "minimum": 1, "maximum": 3},
        "cache_dir": {"type": "string", "minLength": 1},
        "source_to_character": {
          "type": "object",
          "propertyNames": {"pattern": "^source_[0-2]$"},
          "additionalProperties": {"type": "string", "pattern": "^char_[A-Za-z0-9_-]+$"}
        },
        "vad_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "min_speech_duration_ms": {"type": "integer", "minimum": 1},
        "min_silence_duration_ms": {"type": "integer", "minimum": 0},
        "diarization_window_seconds": {"type": "number", "exclusiveMinimum": 0},
        "diarization_hop_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_cosine_distance": {"type": "number", "minimum": 0, "maximum": 2},
        "separation_chunk_seconds": {"type": "number", "exclusiveMinimum": 0},
        "separation_overlap_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "audio": {
      "type": "object",
      "properties": {
        "final_mix": {"enum": ["original", "separated_sources"]}
      },
      "additionalProperties": true
    },
    "director": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["automatic", "manual", "hybrid"]},
        "automatic_closeups": {"type": "boolean"},
        "reaction_shots": {"type": "boolean"},
        "min_shot_duration": {"type": "number", "minimum": 0},
        "camera_hysteresis": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time"],
        "properties": {
          "time": {"type": "number", "minimum": 0},
          "camera": {"type": "string"},
          "character": {"type": "string"},
          "expression": {"type": "string"},
          "motion": {"type": "string"},
          "priority": {"type": "integer", "minimum": 0, "maximum": 10},
          "reaction_delay": {"type": "number", "minimum": 0},
          "transition": {"enum": ["cut", "fade", "dissolve"]}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "required": ["start", "end", "speaker_id"],
      "properties": {
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0},
        "speaker_id": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "overlap": {"type": "boolean"},
        "emotion": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
